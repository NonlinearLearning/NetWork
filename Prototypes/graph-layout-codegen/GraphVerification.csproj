<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetWork.Prototype.GraphLayoutCodegen.Verification</AssemblyName>
    <RootNamespace>Terraria.NetWork.Prototype.GraphLayoutCodegen</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="src\test1\**\*.cs" />
    <Compile Include="src\runtime\**\*.cs" />
    <Compile Include="tests\*.cs" />
    <Compile Include="Build\generated\*GeneratedCodec.g.cs" />
    <PackageReference Include="QuikGraph" Version="2.5.0" />
  </ItemGroup>
</Project>
